{
  "name": "momako",
  "version": "0.1.0",
  "description": "Scaffolding CLI for the Momako game jam starter matrix",
  "type": "module",
  "bin": {
    "momako": "./bin/momako.js"
  },
  "exports": {
    ".": "./src/cli.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "_AGENTS.md",
    "versions.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node ./bin/momako.js",
    "test": "node --test",
    "prepack": "node scripts/prepack.js",
    "postpack": "node scripts/postpack.js"
  },
  "keywords": [
    "game-jam",
    "phaser",
    "threejs",
    "godot",
    "unity",
    "scaffold",
    "cli"
  ],
  "author": "Momakoding",
  "license": "MIT"
}
